{
  "fontStyles": {
    "comment": "italic",
    "function-declaration": "bold",
    "type": {
      "ardoise": "",
      "papier": "italic"
    },
    "type-declaration": "bold",
    "heading-1": "bold",
    "heading-2": "bold",
    "heading-3": "bold",
    "invalid": "italic",
    "deprecated": "italic strikethrough",
    "selector": "bold",
    "modifier": {
      "ardoise": "",
      "papier": "italic"
    }
  },
  "tokenColors": [
    {
      "color": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "variable.other.constant",
        "variable.other.readwrite",
        "variable.other.object",
        "support.variable",
        "entity.name.namespace",
        "entity.name.module",
        "meta.definition.variable",
        "meta.jsx.children",
        "meta.embedded",
        "meta.template.expression",
        "string variable",
        "meta.output"
      ]
    },
    {
      "color": "operator",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ]
    },
    {
      "color": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.comment",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.tag",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "storage.modifier.import",
        "storage.modifier.package",
        "storage.type.java",
        "markup.ignored",
        "markup.untracked",
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ]
    },
    {
      "color": "comment",
      "scope": ["comment", "string.comment"]
    },
    {
      "color": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "constant.other.placeholder",
        "meta.diff.header",
        "string.regexp keyword.operator",
        "keyword.control.anchor.regexp"
      ]
    },
    {
      "color": "modifier",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.control.export",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.default"
      ]
    },
    {
      "color": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.function.macro"
      ]
    },
    {
      "color": "function-declaration",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function entity.name.function",
        "meta.function.definition entity.name.function",
        "entity.name.function.definition"
      ]
    },
    {
      "color": "type",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.type.primitive",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element",
        "entity.name.scope-resolution"
      ]
    },
    {
      "color": "type-declaration",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.type.module"
      ]
    },
    {
      "color": "string",
      "scope": [
        "string",
        "punctuation.definition.string",
        "source.regexp",
        "string.regexp",
        "string.other.link",
        "constant.other.reference.link",
        "markup.inline.raw",
        "markup.underline.link"
      ]
    },
    {
      "color": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.other.character-class.regexp",
        "string.regexp constant.character.escape",
        "string.regexp.character-class",
        "entity.name.constant",
        "variable.other.enummember",
        "support.constant",
        "keyword.other.unit",
        "support.constant.property-value"
      ]
    },
    {
      "color": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "meta.object.member"
      ]
    },
    {
      "color": "constant",
      "scope": ["support.type.property-name", "entity.other.attribute-name", "meta.property-name"]
    },
    {
      "color": "tag",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json string.quoted"
      ]
    },
    {
      "color": "heading-2",
      "scope": ["markup.heading", "markup.heading entity.name", "meta.diff.range", "meta.separator"]
    },
    {
      "color": "variable",
      "fontStyle": "bold",
      "scope": ["markup.bold"]
    },
    {
      "color": "variable",
      "fontStyle": "italic",
      "scope": ["markup.italic"]
    },
    {
      "color": "variable",
      "fontStyle": "underline",
      "scope": ["markup.underline"]
    },
    {
      "color": "punctuation",
      "fontStyle": "strikethrough",
      "scope": ["markup.strikethrough"]
    },
    {
      "color": "variable",
      "fontStyle": "bold italic",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"]
    },
    {
      "color": "property",
      "fontStyle": "italic",
      "scope": ["markup.quote"]
    },
    {
      "color": "heading-1",
      "scope": ["heading.1.markdown entity.name.section.markdown"]
    },
    {
      "color": "heading-3",
      "scope": [
        "heading.3.markdown entity.name.section.markdown",
        "heading.4.markdown entity.name.section.markdown",
        "heading.5.markdown entity.name.section.markdown",
        "heading.6.markdown entity.name.section.markdown"
      ]
    },
    {
      "color": "code",
      "scope": ["markup.inline.raw.string.markdown", "fenced_code.block.language"]
    },
    {
      "color": "link",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown",
        "meta.link.inet.markdown markup.underline.link.markdown",
        "meta.link.email.lt-gt.markdown markup.underline.link.markdown"
      ]
    },
    {
      "color": "punctuation",
      "scope": [
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown",
        "string.other.link.description.title.markdown",
        "constant.other.reference.link.markdown"
      ]
    },
    {
      "color": "punctuation",
      "fontStyle": "",
      "scope": [
        "punctuation.definition.heading.markdown",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.italic.markdown",
        "punctuation.definition.strikethrough.markdown",
        "punctuation.definition.raw.markdown",
        "punctuation.definition.markdown",
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.link.markdown",
        "punctuation.definition.link.title.begin.markdown",
        "punctuation.definition.link.title.end.markdown",
        "punctuation.definition.link.description.begin.markdown",
        "punctuation.definition.link.description.end.markdown",
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.constant.markdown",
        "punctuation.definition.constant.begin.markdown",
        "punctuation.definition.constant.end.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown",
        "punctuation.definition.table.markdown",
        "punctuation.separator.table.markdown",
        "punctuation.separator.key-value.markdown",
        "markup.heading.setext",
        "meta.separator.markdown"
      ]
    },
    {
      "color": "inserted",
      "background": "inserted-background",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"]
    },
    {
      "color": "deleted",
      "background": "deleted-background",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"]
    },
    {
      "color": "changed",
      "background": "changed-background",
      "scope": ["markup.changed", "punctuation.definition.changed"]
    },
    {
      "color": "invalid",
      "scope": [
        "invalid",
        "invalid.broken",
        "invalid.illegal",
        "invalid.unimplemented",
        "message.error",
        "brackethighlighter.unmatched"
      ]
    },
    {
      "color": "invalid",
      "background": "invalid-background",
      "scope": ["carriage-return"]
    },
    {
      "color": "deprecated",
      "scope": ["invalid.deprecated"]
    },
    {
      "color": "selector",
      "scope": [
        "meta.selector entity.other.attribute-name",
        "meta.selector entity.name.tag",
        "meta.selector punctuation.definition.entity",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.parent-selector.css"
      ]
    }
  ],
  "semanticTokenColors": {
    "variable": "variable",
    "variable.readonly": "variable",
    "variable.defaultLibrary": "variable",
    "parameter": "variable",
    "namespace": "variable",
    "label": "variable",
    "operator": "operator",
    "keyword": "keyword",
    "selfParameter": "keyword",
    "function": "function",
    "function.defaultLibrary": "function",
    "method": "function",
    "macro": "function",
    "decorator": "function",
    "function.declaration": "function-declaration",
    "method.declaration": "function-declaration",
    "class": "type",
    "class.defaultLibrary": "type",
    "interface": "type",
    "type": "type",
    "typeParameter": "type",
    "enum": "type",
    "struct": "type",
    "class.declaration": "type-declaration",
    "interface.declaration": "type-declaration",
    "type.declaration": "type-declaration",
    "enum.declaration": "type-declaration",
    "struct.declaration": "type-declaration",
    "string": "string",
    "regexp": "string",
    "number": "constant",
    "enumMember": "constant",
    "property": "property",
    "property.readonly": "property",
    "*.deprecated": "deprecated"
  }
}
