{
	"findings": [
		"Title, activity and status bars share the editor background while sidebar and panel go darker: chrome has no single step, so nothing frames the editor.",
		"Body text is #e6edf3 (16:1) in the editor, sidebar, tabs, lists and terminal alike: peak contrast is spent on scaffolding.",
		"The primary button is green: green is spent on an action instead of meaning \"added\".",
		"Active tab, activity bar and panel tab markers are coral, a red-family hue for \"active\", while focus rings are blue: two hues for one meaning.",
		"One yellow means warning, modified file, modified gutter, modified setting, stack frame and debug source; merge conflicts are orange, not red.",
		"Green also marks selection highlight, bracket match and the focused stack frame, so they read as \"added\".",
		"Badges are solid blue with white text, as loud as the focus ring for a level-3 count.",
		"Bracket pairs and symbol icons use red, yellow and green; symbolIcon.constantForeground is an array (invalid) in Dark; ansiBrightWhite is pure #ffffff."
	],
	"roles": {
		"surface.editor": {
			"importance": 1,
			"dark": "background",
			"light": "background",
			"why": "The page you read; everything else steps away from it."
		},
		"surface.chrome": {
			"importance": 1,
			"dark": "oklch(0.245 0.018 gray)",
			"light": "oklch(0.91 0.022 stone)",
			"why": "Sidebar, bars, panel, tabs: one step below the editor."
		},
		"surface.overlay": {
