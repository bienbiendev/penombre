{
  "name": "penombre",
  "displayName": "Penombre",
  "description": "Half-light themes: slate and paper, on the GitHub color range",
  "version": "0.2.0",
  "publisher": "bienoubien",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bienbiendev/penombre.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Penombre Ardoise",
        "uiTheme": "vs-dark",
        "path": "./themes/penombre-ardoise.json"
      },
      {
        "label": "Penombre Papier",
        "uiTheme": "vs",
        "path": "./themes/penombre-papier.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node src/build.js",
    "build": "node src/build.js",
    "watch": "node --watch-path=src --watch-path=blueprint --watch-path=colors src/build.js",
    "preview": "code --extensionDevelopmentPath=$PWD $PWD/preview",
    "install-local": "bunx @vscode/vsce@4.1.0 package --no-dependencies --readme-path docs/MARKETPLACE.md -o penombre.vsix && code --install-extension penombre.vsix --force",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.9"
  }
}
