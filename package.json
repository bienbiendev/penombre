{
	"name": "sunglass",
	"displayName": "Sunglass",
	"description": "Low-glare dark and light themes on the GitHub color range",
	"version": "0.1.0",
	"publisher": "bienoubien-studio",
	"license": "MIT",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"label": "Sunglass Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/sunglass-dark.json"
			},
			{
				"label": "Sunglass Light",
				"uiTheme": "vs",
				"path": "./themes/sunglass-light.json"
			}
		]
	},
	"scripts": {
		"build": "node src/build.js",
		"watch": "node --watch-path=src --watch-path=blueprint src/build.js",
		"preview": "code --extensionDevelopmentPath=$PWD $PWD/preview",
		"install-local": "node src/build.js && bunx @vscode/vsce@3 package --allow-missing-repository --skip-license -o sunglass.vsix && code --install-extension sunglass.vsix --force"
	}
}
