				"markup.strikethrough"
			],
			"settings": {
				"foreground": "#332e29",
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#31643a",
				"background": "#1a7f3733"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#7c2a2f",
				"background": "#ffebe9"
			}
		},
		{
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#835003",
				"background": "#9a670033"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.broken",
				"invalid.illegal",
				"invalid.unimplemented",
				"message.error",
				"brackethighlighter.unmatched"
			],
			"settings": {
				"foreground": "#7c2a2f",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"carriage-return"
			],
			"settings": {
				"foreground": "#7c2a2f",
				"background": "#cf222e66",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#7c2a2f",
				"fontStyle": "italic strikethrough"
			}
		},
		{
			"scope": [
				"meta.selector entity.other.attribute-name",
				"meta.selector entity.name.tag",
				"meta.selector punctuation.definition.entity",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"entity.other.attribute-name.pseudo-class.css",
				"entity.other.attribute-name.pseudo-element.css",
				"entity.name.tag.css",
				"entity.other.attribute-name.parent-selector.css"
			],
			"settings": {
				"foreground": "#7454bb",
				"fontStyle": "bold"
			}
		}
	],
